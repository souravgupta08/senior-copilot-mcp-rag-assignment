# ---------- Alarm Management API (simulator) ----------
ALARM_API_BASE_URL=http://localhost:8000
# Must match the token the simulator expects (Postman collections use demo-token)
ALARM_API_TOKEN=demo-token
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=2

# ---------- MCP server ----------
# Empty = the copilot starts the MCP server itself over stdio (easiest for local runs)
# Set it to use the HTTP MCP server, e.g. http://localhost:9000 (docker compose sets http://alarm-mcp:9000)
MCP_SERVER_URL=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_TOOL_TIMEOUT_SECONDS=30
# Comma separated tool names to hide (demo of "tool unavailable"), e.g. correlate_alarms
MCP_DISABLED_TOOLS=

# ---------- LLM (optional) ----------
# groq = write the final answer with an LLM; none = use the built-in template answer
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=replace-me

# ---------- RAG ----------
DOCUMENT_PATH=./rag/documents
RAG_INDEX_PATH=./rag/index/alarm_docs_index.json
RAG_MIN_SCORE=0.12

# ---------- Simulator demo switches ----------
SIM_FAILURE_RATE=0
SIM_LATENCY_MS=0
